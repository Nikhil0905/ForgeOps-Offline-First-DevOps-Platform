# --- Docker Registry ---
REGISTRY_HOST=registry:5000
REGISTRY_STORAGE_PATH=/var/lib/registry

# --- Nexus Maven Mirror ---
NEXUS_ADMIN_PASSWORD=77f7df5b-50de-4051-aea1-90a731442e70
NEXUS_PORT=8081

# --- Dashboard Backend ---
FLASK_SECRET_KEY=flask-secret-forgeops-2025
