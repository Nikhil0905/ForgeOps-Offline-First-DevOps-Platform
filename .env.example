# ============================================================
# ForgeOps — Shared Environment Configuration (Template)
# ============================================================
# Copy this file to .env and update the values as needed:
#   cp .env.example .env

# --- Gitea ---
GITEA_ADMIN_USER=forgeops
GITEA_ADMIN_PASSWORD=ForgeOps@2025
GITEA_ADMIN_EMAIL=admin@forgeops.local
GITEA_SECRET_KEY=s3cr3tk3y-forgeops-gitea
GITEA_INTERNAL_TOKEN=internaltoken-forgeops

# --- Jenkins ---
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=ForgeOps@Jenkins2025
JENKINS_URL=http://jenkins:8080/jenkins

# --- Docker Registry ---
REGISTRY_HOST=registry:5000
REGISTRY_STORAGE_PATH=/var/lib/registry

# --- Nexus Maven Mirror ---
NEXUS_ADMIN_PASSWORD=ForgeOps@Nexus2025
NEXUS_PORT=8081

# --- Dashboard Backend ---
FLASK_SECRET_KEY=flask-secret-forgeops-2025
DASHBOARD_PORT=5050

# --- Database (SQLite path inside container) ---
DB_PATH=/data/forgeops.db

# --- Sync Engine ---
SYNC_INTERVAL_SECONDS=60
# Format: https://<GITHUB_PAT>@github.com/<OWNER>/<REPO>.git
# Each local Gitea repo will be synced as a branch: projects/<repo_name>
# NOTE: The PAT must have Contents read/write access to the target repo
REMOTE_GIT_URL=https://<YOUR_GITHUB_PAT>@github.com/<YOUR_USERNAME>/<YOUR_ORG_REPO>.git
REMOTE_REGISTRY_URL=registry.hub.docker.com

# --- Backup ---
BACKUP_DIR=/backups
BACKUP_SCHEDULE=86400

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=ForgeOps@Grafana2025
